# Server-side OpenAI visual forensics. Never prefix these with VITE_ or expose them to browser code.
OPENAI_API_KEY=
OPENAI_FORENSICS_MODEL=gpt-5.6-terra
OPENAI_CRITIC_MODEL=gpt-5.6-sol
AI_MAX_PROJECT_COST_USD=0.75
AI_TARGET_PROJECT_COST_USD=0.50
AI_MONTHLY_BUDGET_USD=15
AI_SOL_ESCALATION_ENABLED=true
AI_REQUEST_TIMEOUT_MS=120000
AI_MAX_RETRIES=1
AI_MAX_IMAGE_MB=10
AI_BUDGET_RESERVATION_TTL_SECONDS=600
AI_BUDGET_RESERVATION_SAFETY_FACTOR=1.20
AI_ALLOW_INMEMORY_BUDGET=false
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
AI_ART_DIRECTOR_MAX_REVISION_ROUNDS=1
AI_SENIOR_CRITIC_TARGET_USD=0.10
AI_SENIOR_CRITIC_MAX_USD=0.18
AI_ART_DIRECTION_REVISION_TARGET_USD=0.06
AI_ART_DIRECTION_REVISION_MAX_USD=0.10
OPENAI_IMAGE_MODEL=gpt-image-2
AI_IMAGE_GENERATION_TARGET_USD=0.22
AI_IMAGE_GENERATION_MAX_USD=0.35
AI_IMAGE_REQUEST_TIMEOUT_MS=180000
AI_IMAGE_MAX_RETRIES=1
AI_GENERATED_IMAGE_MAX_MB=20
# Required for paid image calls until an authoritative provider price registry is available.
AI_IMAGE_ESTIMATED_COST_USD=
# Set to mock for deterministic local validation without an API key.
AI_IMAGE_PROVIDER=openai
ASSET_ALLOW_INMEMORY_STORAGE=false
ASSET_SIGNED_URL_TTL_SECONDS=300
ASSET_STORAGE_MAX_RETRIES=1
OPENAI_POST_RENDER_QA_MODEL=
OPENAI_POST_RENDER_QA_ESCALATION_MODEL=
AI_POST_RENDER_QA_SOL_ESCALATION_ENABLED=true
AI_POST_RENDER_QA_TARGET_USD=0.06
AI_POST_RENDER_QA_MAX_USD=0.10
POST_RENDER_QA_MAX_IMAGES=4
EXPORT_WEBP_QUALITY=92
EXPORT_MAX_SINGLE_FILE_MB=40
EXPORT_MAX_PACKAGE_MB=150
EXPORT_ALLOW_INMEMORY_STORAGE=true
EXPORT_READ_HANDLE_TTL_SECONDS=300
AI_IMAGE_REGENERATION_TARGET_USD=0.18
AI_IMAGE_REGENERATION_MAX_USD=0.30
AI_POST_RENDER_MAX_REGENERATION_ROUNDS=1
